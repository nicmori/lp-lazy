{
  "manifest_version": 3,
  "name": "lp-lazy",
  "version": "1.0.0",
  "description": "Flags sellers who blanket-list Near Mint cards as Light Play.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.tcgplayer.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_title": "lp-lazy",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tcgplayer.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ]
}